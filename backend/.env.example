# --- OpenRouter ---
# Preferred: put your key in a plain text file (e.g. token.txt, or wherever
# your own secrets setup keeps it) and point OPENROUTER_API_KEY_FILE at it.
# The app reads OPENROUTER_API_KEY directly if set; otherwise it falls back
# to reading OPENROUTER_API_KEY_FILE. Only one of the two is required.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=token.txt

# Any model slug OpenRouter serves that supports tool/function calling.
# Check https://openrouter.ai/models for current options and pricing.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional but recommended by OpenRouter for their leaderboards/rate limits -
# safe to leave blank.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Gem Exchange Demo

# Comma-separated list of origins allowed to call this API (your frontend URL).
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Leave empty for local dev: a SQLite file (inventory.db) is created next to
# main.py. In production, set it to your Supabase "Session pooler"
# connection string (Supabase dashboard -> Connect), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Admin (/admin) ---
# The first owner account is created from these when there are no users yet.
# Password must be at least 10 characters. Ignored once any user exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret used to sign admin login tokens. Any long random string. If unset,
# a temporary one is used and everyone is logged out on restart.
ADMIN_JWT_SECRET=

# --- Media storage (stone photos and videos) ---
# Leave empty for local dev: uploads are saved in backend/uploads/.
# In production, use Supabase Storage (the bucket is created automatically):
#   SUPABASE_URL: Project Settings -> Data API -> Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API Keys -> a secret key
#     (sb_secret_...) or the legacy service_role key. Server-side only!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=stone-media
