# --- OpenRouter ---
# Preferred: put your key in a plain text file (e.g. token.txt, or wherever
# your own secrets setup keeps it) and point OPENROUTER_API_KEY_FILE at it.
# The app reads OPENROUTER_API_KEY directly if set; otherwise it falls back
# to reading OPENROUTER_API_KEY_FILE. Only one of the two is required.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=token.txt

# Any model slug OpenRouter serves that supports tool/function calling.
# Check https://openrouter.ai/models for current options and pricing.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional but recommended by OpenRouter for their leaderboards/rate limits -
# safe to leave blank.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Gem Exchange Demo

# Comma-separated list of origins allowed to call this API (your frontend URL).
FRONTEND_ORIGIN=http://localhost:5173
